{
  "name": "stemdeck",
  "productName": "StemDeck",
  "version": "0.1.0",
  "description": "Free stem separation, remixing and DJ app",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env STEMDECK_DEV=1 electron .\"",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "app.stemdeck.desktop",
    "productName": "StemDeck",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/stemdeck-engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "publish": null
  },
  "dependencies": {
    "immer": "^10.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.5"
  },
  "type": "module",
  "repository": "https://github.com/kjbinkley01-bot/music"
}
